<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>false</UseWindowsForms>
    <UseWPF>false</UseWPF>
    <OutputType>Exe</OutputType>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishTrimmed>false</PublishTrimmed>
    <AssemblyTitle>BootstrapMate</AssemblyTitle>
    <AssemblyDescription>MDM-agnostic bootstrapping tool for Windows</AssemblyDescription>
    <AssemblyCompany>Windows Admins Open Source</AssemblyCompany>
    <AssemblyProduct>BootstrapMate</AssemblyProduct>
    <AssemblyCopyright>Windows Admins Open Source 2025</AssemblyCopyright>
    <AssemblyName>managedbootstrapinstall</AssemblyName>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <WarningsAsErrors />
    <WarningsNotAsErrors>NU1701;IL2026</WarningsNotAsErrors>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <!-- Generate build timestamp at compile time -->
  <PropertyGroup>
    <BuildTimestamp>$([System.DateTime]::Now.ToString("yyyy.MM.dd.HHmm"))</BuildTimestamp>
    <!-- Use BuildTimestamp for assembly versions (MSI-compatible format) -->
    <AssemblyVersion>$(BuildTimestamp)</AssemblyVersion>
    <FileVersion>$(BuildTimestamp)</FileVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="src\BootstrapMate.Core\BootstrapMate.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="YamlDotNet" Version="16.3.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Program-Generic.cs" />
    <Compile Remove="src\**" />
    <Content Remove="src\**" />
    <None Remove="src\**" />
    <EmbeddedResource Remove="src\**" />
  </ItemGroup>

  <!-- Version is read at runtime from this AssemblyMetadata attribute
       (see src/BootstrapMate.Core/BootstrapMateConstants.cs) -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>BuildTimestamp</_Parameter1>
      <_Parameter2>$(BuildTimestamp)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
