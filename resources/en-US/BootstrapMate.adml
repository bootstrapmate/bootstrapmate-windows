<?xml version="1.0" encoding="utf-8"?>
<!--
  BootstrapMate ADML Language File (English)
  Companion to BootstrapMate.admx
-->
<policyDefinitionResources xmlns:xsd="http://www.w3.org/2001/XMLSchema"
                           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                           revision="1.0"
                           schemaVersion="1.0"
                           xmlns="http://schemas.microsoft.com/GroupPolicy/2006/07/PolicyDefinitions">

  <displayName>BootstrapMate</displayName>
  <description>BootstrapMate enterprise device provisioning settings</description>

  <resources>
    <stringTable>
      <!-- Categories -->
      <string id="Cat_BootstrapMate">BootstrapMate</string>
      <string id="Cat_Connection">Connection</string>
      <string id="Cat_Behavior">Behavior</string>
      <string id="Cat_Dialog">Dialog</string>
      <string id="Cat_Advanced">Advanced</string>
      <string id="Cat_Reporting">Reporting</string>
      <string id="Cat_Security">Security</string>

      <!-- Connection -->
      <string id="ManifestUrl">Manifest URL</string>
      <string id="ManifestUrl_Help">URL to the bootstrapmate.json manifest file that defines packages to install.

Example: https://example.com/bootstrap/bootstrapmate.json

When set, BootstrapMate will automatically use this URL without requiring the --url command-line argument.</string>

      <string id="AuthorizationHeader">Authorization Header</string>
      <string id="AuthorizationHeader_Help">Authorization header value sent with manifest and package download requests.

Example: Bearer eyJhbGciOiJIUzI1NiIs...

Leave empty if your manifest endpoint does not require authentication.</string>

      <!-- Behavior -->
      <string id="SilentMode">Silent Mode</string>
      <string id="SilentMode_Help">When enabled, all console output is suppressed. Log files are still written.

Default: Disabled</string>

      <string id="VerboseMode">Verbose Logging</string>
      <string id="VerboseMode_Help">When enabled, debug-level messages are shown in console output and logs.

Default: Disabled</string>

      <string id="DryRun">Dry Run</string>
      <string id="DryRun_Help">When enabled, BootstrapMate refuses to run: it logs an error and exits with code 1 without downloading or installing anything. BootstrapMate has no simulated install, so this is a safety stop, not a test mode.

Default: Disabled</string>

      <!-- Dialog -->
      <string id="EnableDialog">Enable Progress Dialog</string>
      <string id="EnableDialog_Help">When enabled, a progress dialog (csharpdialog) is shown during installation if available.

Default: Enabled</string>

      <string id="DialogTitle">Dialog Title</string>
      <string id="DialogTitle_Help">Custom title text shown in the progress dialog window.

Default: Setting Up Your Device</string>

      <string id="DialogMessage">Dialog Message</string>
      <string id="DialogMessage_Help">Custom message text shown in the progress dialog window.

Default: Please wait while we install required software...</string>

      <string id="DialogIcon">Dialog Icon</string>
      <string id="DialogIcon_Help">Path to a custom icon file (.ico, .png) shown in the progress dialog.

Leave empty to use the default icon.</string>

      <string id="BlurScreen">Blur Screen Behind Dialog</string>
      <string id="BlurScreen_Help">When enabled, the screen behind the progress dialog is blurred to prevent user interaction during setup.

Default: Disabled</string>

      <!-- Advanced -->
      <string id="CustomInstallPath">Custom Install Path</string>
      <string id="CustomInstallPath_Help">Override the default BootstrapMate installation directory.

Default: C:\Program Files\BootstrapMate</string>

      <string id="BaselineMinIntervalHours">Minimum Hours Between Baseline Runs</string>
      <string id="BaselineMinIntervalHours_Help">A baseline run that starts less than this many hours after the last completed baseline exits as a skip before downloading anything. A failed, partially failed or interrupted baseline gets one retry after 24 hours, never sooner; if that retry fails too, the full interval applies. Provisioning runs are not limited. While C:\ProgramData\ManagedBootstrap\.bootstrap_force is present the limit does not apply; the preflight consumes the file.

Range: 0-8760 hours
Default: 144 hours (6 days)</string>

      <string id="NetworkTimeout">Network Timeout (seconds)</string>
      <string id="NetworkTimeout_Help">Timeout in seconds for the manifest request, and how long a package download may go without receiving data before the attempt fails and is retried. A large package keeps downloading for as long as data keeps arriving.

Range: 10–600 seconds
Default: 120 seconds</string>

      <!-- Reporting -->
      <string id="ReportingUrl">Reporting URL</string>
      <string id="ReportingUrl_Help">URL to POST a vendor-neutral JSON run summary to when a bootstrap run completes.

The payload includes the run ID, version, success, duration, architecture, hostname, serial number, manifest URL, and per-phase outcomes. Any endpoint that accepts a JSON POST can consume it.

Leave empty to disable reporting. The POST is best-effort: it is bounded by a short timeout and never fails the run (a slow or unreachable endpoint can delay completion by up to that timeout).</string>

      <string id="ReportingHeader">Reporting Authorization Header</string>
      <string id="ReportingHeader_Help">Optional Authorization header value sent with the reporting POST request.

Example: Bearer eyJhbGciOiJIUzI1NiIs...

Leave empty if your reporting endpoint does not require authentication.</string>
      <!-- Security -->
      <string id="VerifyPackageSignatures">Verify package signatures</string>
      <string id="VerifyPackageSignatures_Help">Verify the Authenticode signature of MSI/EXE installers before running them elevated. The download only proves where bytes came from, not who produced them.

When Enabled (or not configured), installers must carry a signature trusted by Windows. When Disabled, signature verification is skipped (NOT recommended).

Default: Enabled</string>

      <string id="ExpectedPublisher">Expected publisher</string>
      <string id="ExpectedPublisher_Help">Require MSI/EXE installers to be signed by a certificate whose common name (or subject) contains this value (e.g. your organization name).

When empty, any signature trusted by Windows is accepted. A publisher mismatch is always refused, even when "Allow unsigned packages" is enabled.</string>

      <string id="AllowUnsigned">Allow unsigned packages</string>
      <string id="AllowUnsigned_Help">Permit unsigned or untrusted MSI/EXE installers to run (logged as a warning). A publisher mismatch is never bypassed by this setting.

Default: Disabled</string>
    </stringTable>

    <presentationTable>
      <presentation id="ManifestUrl">
        <textBox refId="ManifestUrl_Value">
          <label>Manifest URL:</label>
        </textBox>
      </presentation>

      <presentation id="AuthorizationHeader">
        <textBox refId="AuthorizationHeader_Value">
          <label>Authorization Header:</label>
        </textBox>
      </presentation>

      <presentation id="DialogTitle">
        <textBox refId="DialogTitle_Value">
          <label>Title:</label>
        </textBox>
      </presentation>

      <presentation id="DialogMessage">
        <textBox refId="DialogMessage_Value">
          <label>Message:</label>
        </textBox>
      </presentation>

      <presentation id="DialogIcon">
        <textBox refId="DialogIcon_Value">
          <label>Icon Path:</label>
        </textBox>
      </presentation>

      <presentation id="CustomInstallPath">
        <textBox refId="CustomInstallPath_Value">
          <label>Install Path:</label>
        </textBox>
      </presentation>

      <presentation id="NetworkTimeout">
        <decimalTextBox refId="NetworkTimeout_Value" defaultValue="120">Timeout (seconds):</decimalTextBox>
      </presentation>
      <presentation id="BaselineMinIntervalHours">
        <decimalTextBox refId="BaselineMinIntervalHours_Value" defaultValue="144">Hours between baseline runs:</decimalTextBox>
      </presentation>

      <presentation id="ReportingUrl">
        <textBox refId="ReportingUrl_Value">
          <label>Reporting URL:</label>
        </textBox>
      </presentation>

      <presentation id="ReportingHeader">
        <textBox refId="ReportingHeader_Value">
          <label>Authorization Header:</label>
        </textBox>
      </presentation>

      <presentation id="ExpectedPublisher">
        <textBox refId="ExpectedPublisher_Value">
          <label>Expected publisher:</label>
        </textBox>
      </presentation>
    </presentationTable>
  </resources>
</policyDefinitionResources>
