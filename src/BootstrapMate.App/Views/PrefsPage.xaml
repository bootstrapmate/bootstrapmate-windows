<Page
    x:Class="BootstrapMate.App.Views.PrefsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:BootstrapMate.App.ViewModels"
    xmlns:core="using:BootstrapMate.Core"
    NavigationCacheMode="Required">

    <Page.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="20" />
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ScrollViewer Padding="28,24,28,24">
            <StackPanel Spacing="20" MaxWidth="1040" HorizontalAlignment="Stretch">

            <!-- ═══ App Info Header ═══ -->
            <StackPanel HorizontalAlignment="Center" Spacing="8" Margin="0,8,0,4">
                <Image x:Name="AppIcon" Width="64" Height="64" HorizontalAlignment="Center" />

                <TextBlock Text="Managed Bootstrap Install"
                           Style="{StaticResource TitleTextBlockStyle}"
                           HorizontalAlignment="Center" />

                <TextBlock Text="Enterprise management tools provisioning for automated device setup using manifests."
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextAlignment="Center" MaxWidth="500"
                           TextWrapping="WrapWholeWords" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="16">
                    <HyperlinkButton Content="Documentation"
                                     NavigateUri="https://github.com/bootstrapmate/bootstrapmate-windows/wiki" />
                    <HyperlinkButton Content="Report Issue"
                                     NavigateUri="https://github.com/bootstrapmate/bootstrapmate-windows/issues" />
                </StackPanel>

                <TextBlock Text="{x:Bind ViewModel.VersionDisplay, Mode=OneWay}"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                           HorizontalAlignment="Center" />
            </StackPanel>

            <!-- ═══ Policy note: values set by policy show as disabled (gray) fields ═══ -->
            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center"
                        Visibility="{x:Bind ViewModel.HasPolicySettings, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                <FontIcon Glyph="&#xE72E;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Text="Settings shown in gray have been configured by a policy."
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <!-- ═══ Read-only banner: settings live in HKLM, so editing needs elevation ═══ -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16,12"
                    Visibility="{x:Bind ViewModel.IsReadOnly, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Spacing="6">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE72E;" FontSize="16" VerticalAlignment="Center"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" TextWrapping="WrapWholeWords"
                                   Text="Settings are read-only. Unlock to change them (requires administrator)." />
                        <Button Grid.Column="2" x:Name="UnlockButton" Click="UnlockButton_Click"
                                ToolTipService.ToolTip="Relaunch as administrator to edit settings">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xEA18;" FontSize="14" />
                                <TextBlock Text="Unlock" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <TextBlock Text="{x:Bind ViewModel.UnlockError, Mode=OneWay}"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                               TextWrapping="Wrap"
                               Visibility="{x:Bind ViewModel.HasUnlockError, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center"
                        Visibility="{x:Bind ViewModel.IsElevated, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                <FontIcon Glyph="&#xEA18;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Text="Running as administrator. Changes save to this device's machine settings."
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <!-- ═══ Settings Grid: two even columns; Services spans both ═══ -->
            <Grid ColumnSpacing="16" RowSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- ── Connection Card ── -->
                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource CardStyle}">
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,4">
                        <FontIcon Glyph="&#xE943;" FontSize="20"
                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="Connection" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Manifest URL -->
                    <TextBlock Text="Manifest URL" Style="{StaticResource CaptionTextBlockStyle}" />
                    <Grid ColumnSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Text="{x:Bind ViewModel.ManifestUrl, Mode=TwoWay}"
                                 PlaceholderText="https://example.com/bootstrapmate.json"
                                 IsEnabled="{x:Bind ViewModel.CanEditManifestUrl, Mode=OneWay}" />
                        <Button Grid.Column="1" x:Name="PreviewManifestButton"
                                ToolTipService.ToolTip="Preview manifest content"
                                Click="PreviewManifestButton_Click"
                                Width="36" Padding="6">
                            <FontIcon Glyph="&#xE7B3;" FontSize="14" />
                            <Button.Flyout>
                                <Flyout x:Name="ManifestPreviewFlyout" Placement="BottomEdgeAlignedLeft">
                                    <Flyout.FlyoutPresenterStyle>
                                        <Style TargetType="FlyoutPresenter">
                                            <Setter Property="MaxWidth" Value="9999" />
                                            <Setter Property="Padding" Value="16" />
                                        </Style>
                                    </Flyout.FlyoutPresenterStyle>
                                    <StackPanel Width="640" Spacing="10">
                                        <!-- Flyout header -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Manifest Preview"
                                                       Style="{StaticResource SubtitleTextBlockStyle}"
                                                       VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                        Spacing="8" VerticalAlignment="Center">
                                                <ProgressRing IsActive="{x:Bind ViewModel.IsManifestPreviewLoading, Mode=OneWay}"
                                                              Width="18" Height="18" />
                                                <Button x:Name="RefreshPreviewButton"
                                                        ToolTipService.ToolTip="Refresh"
                                                        Click="PreviewManifestButton_Click"
                                                        Width="32" Height="32" Padding="0">
                                                    <FontIcon Glyph="&#xE72C;" FontSize="12" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                        <!-- Error message -->
                                        <TextBlock Text="{x:Bind ViewModel.ManifestPreviewError, Mode=OneWay}"
                                                   Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                                   TextWrapping="Wrap"
                                                   Visibility="{x:Bind ViewModel.HasManifestPreviewError, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                        <!-- Content -->
                                        <ScrollViewer MaxHeight="420"
                                                      Visibility="{x:Bind ViewModel.HasManifestPreviewContent, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="{x:Bind ViewModel.ManifestPreviewContent, Mode=OneWay}"
                                                       FontFamily="Cascadia Code, Consolas, Courier New"
                                                       FontSize="11"
                                                       TextWrapping="Wrap"
                                                       IsTextSelectionEnabled="True" />
                                        </ScrollViewer>
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </Grid>

                    <!-- Authorization Header -->
                    <TextBlock Text="Authorization Header" Style="{StaticResource CaptionTextBlockStyle}" Margin="0,4,0,0" />
                    <PasswordBox Password="{x:Bind ViewModel.AuthorizationHeader, Mode=TwoWay}"
                                 PlaceholderText="{x:Bind ViewModel.AuthPlaceholderText, Mode=OneWay}"
                                 IsEnabled="{x:Bind ViewModel.CanEditAuthHeader, Mode=OneWay}" />
                </StackPanel>
                </Border>

                <!-- ── Behavior Card ── -->
                <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource CardStyle}">
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,4">
                        <FontIcon Glyph="&#xE713;" FontSize="20"
                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="Behavior" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
                    </StackPanel>

                    <ToggleSwitch OnContent="Suppress console output" OffContent="Suppress console output"
                                  IsOn="{x:Bind ViewModel.SilentMode, Mode=TwoWay}"
                                  IsEnabled="{x:Bind ViewModel.CanEditSilentMode, Mode=OneWay}" />

                    <ToggleSwitch OnContent="Enable verbose logging" OffContent="Enable verbose logging"
                                  IsOn="{x:Bind ViewModel.VerboseMode, Mode=TwoWay}"
                                  IsEnabled="{x:Bind ViewModel.CanEditVerboseMode, Mode=OneWay}" />

                    <ToggleSwitch OnContent="Dry run (refuse to run)" OffContent="Dry run (refuse to run)"
                                  IsOn="{x:Bind ViewModel.DryRun, Mode=TwoWay}"
                                  IsEnabled="{x:Bind ViewModel.CanEditDryRun, Mode=OneWay}" />
                </StackPanel>
                </Border>

                <!-- ── Dialog Card ── -->
                <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource CardStyle}">
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,4">
                        <FontIcon Glyph="&#xE8F2;" FontSize="20"
                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="Dialog" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
                    </StackPanel>

                    <ToggleSwitch OnContent="Show progress dialog" OffContent="Show progress dialog"
                                  IsOn="{x:Bind ViewModel.EnableDialog, Mode=TwoWay}"
                                  IsEnabled="{x:Bind ViewModel.CanEditEnableDialog, Mode=OneWay}" />

                    <TextBlock Text="Title" Style="{StaticResource CaptionTextBlockStyle}" Margin="0,4,0,0" />
                    <TextBox Text="{x:Bind ViewModel.DialogTitle, Mode=TwoWay}" PlaceholderText="Setting Up Your Device"
                             IsEnabled="{x:Bind ViewModel.CanEditDialogTitle, Mode=OneWay}" />

                    <TextBlock Text="Message" Style="{StaticResource CaptionTextBlockStyle}" Margin="0,4,0,0" />
                    <TextBox Text="{x:Bind ViewModel.DialogMessage, Mode=TwoWay}" PlaceholderText="Please wait while we install required software..."
                             IsEnabled="{x:Bind ViewModel.CanEditDialogMessage, Mode=OneWay}" />

                    <TextBlock Text="Icon" Style="{StaticResource CaptionTextBlockStyle}" Margin="0,4,0,0" />
                    <TextBox Text="{x:Bind ViewModel.DialogIcon, Mode=TwoWay}" PlaceholderText="Path to icon file (.ico, .png)"
                             IsEnabled="{x:Bind ViewModel.CanEditDialogIcon, Mode=OneWay}" />

                    <ToggleSwitch Margin="0,4,0,0" OnContent="Blur screen behind dialog" OffContent="Blur screen behind dialog"
                                  IsOn="{x:Bind ViewModel.BlurScreen, Mode=TwoWay}"
                                  IsEnabled="{x:Bind ViewModel.CanEditBlurScreen, Mode=OneWay}" />
                </StackPanel>
                </Border>

                <!-- ── Advanced Card ── -->
                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource CardStyle}">
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,4">
                        <FontIcon Glyph="&#xE90F;" FontSize="20"
                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="Advanced" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBlock Text="Custom Install Path" Style="{StaticResource CaptionTextBlockStyle}" />
                    <TextBox Text="{x:Bind ViewModel.CustomInstallPath, Mode=TwoWay}"
                             PlaceholderText="C:\Program Files\BootstrapMate"
                             IsEnabled="{x:Bind ViewModel.CanEditCustomInstallPath, Mode=OneWay}" />

                    <TextBlock Text="Network Timeout" Style="{StaticResource CaptionTextBlockStyle}" Margin="0,4,0,0" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <NumberBox Value="{x:Bind ViewModel.NetworkTimeoutValue, Mode=TwoWay}" Minimum="10" Maximum="600"
                                   SpinButtonPlacementMode="Compact" SmallChange="10"
                                   Width="120"
                                   IsEnabled="{x:Bind ViewModel.CanEditNetworkTimeout, Mode=OneWay}" />
                        <TextBlock Text="seconds" VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>
                </Border>

                <!-- ── Services Card (read-only: what the installer registers) ── -->
                <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource CardStyle}">
                <StackPanel Spacing="8">
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE912;" FontSize="20"
                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="Services" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <ProgressRing IsActive="{x:Bind ViewModel.IsServicesLoading, Mode=OneWay}" Width="18" Height="18" />
                            <Button x:Name="RefreshServicesButton" Click="RefreshServicesButton_Click"
                                    ToolTipService.ToolTip="Refresh" Width="32" Height="32" Padding="0"
                                    AutomationProperties.Name="Refresh services">
                                <FontIcon Glyph="&#xE72C;" FontSize="12" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.Services, Mode=OneWay}">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="12" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="core:FootprintStatus">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="1.5*" />
                                        <ColumnDefinition Width="1.5*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{x:Bind FriendlyName}" TextWrapping="WrapWholeWords"
                                                   ToolTipService.ToolTip="{x:Bind Description}" />
                                        <TextBlock Text="{x:Bind Name}" Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                                                   IsTextSelectionEnabled="True" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Kind" Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{x:Bind KindText}" TextWrapping="WrapWholeWords" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="State" Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{x:Bind State}" TextWrapping="WrapWholeWords" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="3">
                                        <TextBlock Text="Last result" Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{x:Bind LastResult}" TextWrapping="WrapWholeWords" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="Schedule" Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{x:Bind Trigger}" TextWrapping="WrapWholeWords" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>
                </Border>
            </Grid>

        </StackPanel>
    </ScrollViewer>
    </Grid>
</Page>
